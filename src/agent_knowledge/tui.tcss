/* ============================================================
   Minimal Dark Theme
   Neutral / clean / distraction-free
   ============================================================ */

Screen {
    background: #111111;
    color: #d4d4d4;
}

/* ------------------------------------------------------------ banner */

#banner {
    height: auto;
    margin: 1 1 0 1;
    padding: 0 2;

    background: #111111;

    border: round #2b2b2b;
    border-title-color: #bdbdbd;
    border-title-style: bold;

    color: #e5e5e5;
}

/* ------------------------------------------------------------ tabs */

#tabs {
    height: 1;
    margin: 1 2 0 2;

    color: #a3a3a3;
}

/* ------------------------------------------------------------ filters */

#filters {
    height: 1;
    margin: 0 2;

    color: #737373;
}

/* ------------------------------------------------------------ matrix */

#matrix {
    height: 1fr;
    margin: 1 1 0 1;

    background: #111111;

    border: round #292929;

    scrollbar-size: 1 1;
    scrollbar-color: #3a3a3a;
    scrollbar-background: #111111;
}

#matrix:focus {
    border: round #737373;
}

/* ------------------------------------------------------------ datatable */

DataTable > .datatable--header {
    background: #171717;
    color: #bdbdbd;

    text-style: bold;
}

DataTable > .datatable--cursor {
    background: #262626;
    color: #ffffff;

    text-style: bold;
}

DataTable > .datatable--hover {
    background: #1c1c1c;
}

/* ------------------------------------------------------------ detail */

#detail {
    height: auto;
    min-height: 5;
    max-height: 10;

    margin: 0 1;
    padding: 0 2;

    background: #111111;

    border: round #292929;

    color: #a3a3a3;
}

/* ------------------------------------------------------------ footer */

Footer {
    background: #111111;
    color: #737373;
}

Footer .footer-key--key {
    background: #111111;
    color: #d4d4d4;

    text-style: bold;
}

Footer .footer-key--description {
    background: #111111;
    color: #737373;
}

/* ============================================================ modals */

ConfirmScreen,
PromptScreen,
HelpScreen,
SkillSelectScreen,
SkillDescriptionScreen,
SyncSkillsScreen,
SyncProgressScreen {
    align: center middle;

    background: #000000 70%;
}

McpSearchScreen,
McpDescriptionScreen,
McpConfigScreen {
    align: center middle;
    background: #000000 70%;
}

#mcp-search-dialog, #mcp-config-dialog {
    width: 104;
    max-width: 96%;
    height: 29;
    max-height: 92%;
    padding: 1 2;
    background: #171717;
    border: round #737373;
}

#mcp-results, #mcp-json {
    height: 1fr;
    margin: 1 0;
    background: #111111;
    border: round #292929;
}

#mcp-reference {
    margin: 1 0;
    background: #111111;
    border: round #333333;
}

#dialog {
    width: 72;
    height: auto;
    max-height: 90%;

    padding: 1 2;

    background: #171717;
    color: #d4d4d4;

    border: round #333333;
}

#dialog Input {
    margin-top: 1;

    background: #111111;
    color: #e5e5e5;

    border: round #333333;
}

#dialog Input:focus {
    border: round #737373;
}

#confirm-message {
    height: auto;
    max-height: 12;
    margin: 1 0;
}

/* ------------------------------------------------------------ remote skills */

#remote-skills {
    height: 1fr;
    margin: 1 0;

    background: #111111;

    border: round #292929;
}

#remote-skills > .datatable--cursor {
    background: #262626;
    text-style: none;
}

#skill-select-dialog, #skill-description-dialog {
    width: 100;
    max-width: 96%;
    height: 26;
    max-height: 90%;
    padding: 1 2;
    background: #171717;
    border: round #737373;
}

#skill-description-scroll {
    height: 1fr;
    margin: 1 0;
}

.skill-hint {
    color: #a3a3a3;
    height: auto;
}

#sync-dialog {
    width: 110;
    max-width: 96%;
    height: 30;
    max-height: 90%;
    padding: 1 2;
    background: #171717;
    border: round #737373;
}

#sync-skills {
    height: 1fr;
    margin: 1 0;
    background: #111111;
    border: round #292929;
}

#sync-skills > .datatable--cursor {
    background: #262626;
    text-style: none;
}

.sync-title {
    text-style: bold;
    color: #e5e5e5;
}
