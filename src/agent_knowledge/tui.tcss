/* Phong cách gần Claude Code: nền tối ấm, accent cam #d97757, viền bo tròn, chữ dịu */

Screen {
    background: #1a1918;
    color: #d6d1cb;
}

#banner {
    height: auto;
    margin: 1 1 0 1;
    padding: 0 2;
    border: round #d97757;
    border-title-color: #d97757;
    border-title-style: bold;
    background: #1a1918;
}

#tabs {
    height: 1;
    margin: 1 2 0 2;
}

#filters {
    height: 1;
    margin: 0 2;
    color: #8a847d;
}

#matrix {
    height: 1fr;
    margin: 1 1 0 1;
    background: #1a1918;
    border: round #3a3633;
    scrollbar-size: 1 1;
    scrollbar-color: #3a3633;
    scrollbar-background: #1a1918;
}

#matrix:focus {
    border: round #d97757;
}

DataTable > .datatable--header {
    background: #26231f;
    color: #d97757;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: #4a3329;
    color: #ffffff;
    text-style: bold;
}

DataTable > .datatable--hover {
    background: #26231f;
}

#detail {
    height: auto;
    min-height: 5;
    max-height: 10;
    margin: 0 1;
    padding: 0 2;
    border: round #3a3633;
    color: #b8b2aa;
}

Footer {
    background: #1a1918;
    color: #8a847d;
}

Footer .footer-key--key {
    color: #d97757;
    background: #1a1918;
    text-style: bold;
}

Footer .footer-key--description {
    color: #8a847d;
    background: #1a1918;
}

/* ------------------------------------------------------------ modals */
ConfirmScreen, PromptScreen, HelpScreen {
    align: center middle;
    background: #000000 60%;
}

#dialog {
    width: 72;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    border: round #d97757;
    background: #1a1918;
}

#dialog Input {
    margin-top: 1;
    border: round #3a3633;
    background: #1a1918;
}

#dialog Input:focus {
    border: round #d97757;
}
